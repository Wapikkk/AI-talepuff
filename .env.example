# Salin file ini menjadi `.env` bila ingin mengubah bawaan. SEMUA variabel opsional:
# `.env` kosong pun sah. Jalankan dengan:  uvicorn app.main:app --env-file .env
# Nilai tidak valid menghentikan aplikasi saat startup dengan pesan yang jelas.

# Penyedia model. Saat ini hanya `ollama`.
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Lama Ollama menahan model di memori setelah request terakhir (bawaan Ollama sendiri: 5m).
# Angka detik ("300", "-1" = selamanya) atau berakhiran s/m/h.
# OLLAMA_KEEP_ALIVE=30m

# LLM_TIMEOUT_SECONDS=180
# LLM_CONTEXT_WINDOW=4096
# LLM_MAX_OUTPUT_TOKENS=4096

# Kecepatan baca suara (kata per menit); menentukan target panjang cerita per menit.
# Terukur untuk edge-tts Jenny/Christopher: 109-131. Ukur ulang bila suara diganti.
# WORDS_PER_MINUTE=120

# Percobaan ulang bila cerita tidak lolos validasi (1-5).
# STORY_MAX_ATTEMPTS=3
